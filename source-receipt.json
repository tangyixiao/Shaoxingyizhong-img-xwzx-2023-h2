      },
      "dark": {
        "bg": "#251928",
        "surface": "#3C2540",
        "ink": "#F4E6F2",
        "muted": "#c09bc0",
        "accent": "#de9acd"
      }
    },
    "threeConcept": "Three.js 制作紫色绒面展示台和三层可前后错开的照片屏，屏幕边框不发光；只手动转动观看，照片仍是原始二维画面。",
    "distinctiveInteraction": "点击上、中、下幕的标签，让相应照片到达最前层并显示来源；退出后恢复三幕构图，不做自动轮播。"
  },
